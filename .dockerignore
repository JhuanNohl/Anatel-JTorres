# Ambiente Python do Windows — a imagem cria o seu próprio via requirements.txt
.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc

# Dados de produção: entram por volume (instance/), nunca dentro da imagem
instance/

# Dados do app antigo — já importados para instance/, ver LEIA-ME.txt
dados-app-antigo/

# Instalador/fluxo Windows, sem uso dentro do Docker
*.bat

