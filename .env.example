# Copie este arquivo para ".env" (mesma pasta do docker-compose.yml) e ajuste
# antes do primeiro build. Não existe nenhum IP fixo no código: o Flask sobe
# em 0.0.0.0 (todas as interfaces) e, com network_mode: host no compose, isso
# fica acessível na rede da fábrica como http://192.168.12.74:5000 — sem
# precisar editar nada além destas variáveis.

# Interface em que o servidor escuta DENTRO do container. 0.0.0.0 é o correto
# para host networking; não é o IP que os usuários vão digitar.
ANATEL_HOST=0.0.0.0
ANATEL_PORTA=5000

# Mantenha desligado em produção — liga um console que executa código no
# servidor.
ANATEL_DEBUG=0

# Assina o cookie de sessão. Troque por uma chave própria antes de ir para
# produção (gerar uma nova: python -c "import secrets; print(secrets.token_hex(32))").
ANATEL_SECRET_KEY=

# Sincronização automática da base pública de homologações da ANATEL
# (anatel.gov.br). O servidor tem saída para a internet, então deixe ligado
# (linha comentada = ligado). Só descomente se um dia a rede ficar isolada:
# ANATEL_SEM_AGENDADOR=1

# Não é necessário definir ANATEL_DB / ANATEL_ARQUIVOS / ANATEL_BACKUPS: por
# padrão apontam para instance/, que já está mapeado como volume no compose.
